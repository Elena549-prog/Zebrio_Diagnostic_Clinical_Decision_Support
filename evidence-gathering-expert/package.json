{
  "name": "evidence-gathering-expert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Finds medical papers for a patient presentation and returns verified, cited evidence for probability calculation.",
  "scripts": {
    "evidence": "tsx --env-file-if-exists=../.env.local src/cli.ts",
