# Copy to the repo root as .env.local (git-ignored). Never commit real values.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-5-5)
EVIDENCE_MODEL=
# Optional: Tavily guideline search (free plan, 1,000 credits/month). Without it, DuckDuckGo is used.
TAVILY_API_KEY=
# Optional: local monthly cap on Tavily credits (default 900)
TAVILY_MONTHLY_CREDIT_LIMIT=
