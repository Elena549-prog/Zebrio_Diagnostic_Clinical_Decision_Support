# Server-only credentials. Never use VITE_ prefixes for secrets.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Current Claude model IDs; override for models available to your account.
CLAUDE_ORCHESTRATOR_MODEL=claude-opus-5-5
CLAUDE_ORCHESTRATOR_EFFORT=medium
CLAUDE_RESEARCH_MODEL=claude-haiku-5-5
CLAUDE_VALIDATOR_MODEL=claude-sonnet-5-5
CLAUDE_CODING_MODEL=claude-sonnet-5-5
CLAUDE_TREATMENT_MODEL=claude-sonnet-5-5
CLAUDE_CHAT_MODEL=claude-sonnet-5-5

# Keep this port aligned with the Vite /api proxy.
PORT=8788
